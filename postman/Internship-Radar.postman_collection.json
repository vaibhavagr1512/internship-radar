{
  "info": {
    "name": "Internship Radar \u2014 Days 1\u20133",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run against the local demo app. Selects an untracked demo internship, creates one tracking entry, and removes it. Existing tracking entries are preserved. If interrupted after creation, delete the smokeApplicationId entry manually."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. List internships",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const rows = pm.response.json();",
              "pm.test('List is an array', () => pm.expect(rows).to.be.an('array'));",
              "pm.collectionVariables.set('demoInternships', JSON.stringify(rows.filter(x => x.title.includes('[DEMO]'))));",
              "pm.collectionVariables.unset('smokeApplicationId');",
              "pm.collectionVariables.unset('internshipId');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/internships"
      }
    },
    {
      "name": "2. Case-insensitive Java search",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Every match contains Java in title/company', () => pm.expect(pm.response.json().every(x => /java/i.test(x.title + ' ' + x.company))).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/internships?search=JAVA"
      }
    },
    {
      "name": "3. Unknown internship",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/internships/9223372036854775807"
      }
    },
    {
      "name": "4. Read tracker and choose an untracked demo role",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const existing = new Set(pm.response.json().map(x => x.internship.id));",
              "const candidate = JSON.parse(pm.collectionVariables.get('demoInternships') || '[]').find(x => !existing.has(x.id));",
              "pm.test('An untracked demo role is available for this workflow', () => pm.expect(candidate).to.exist);",
              "if (candidate) pm.collectionVariables.set('internshipId', String(candidate.id));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/applications"
      }
    },
    {
      "name": "5. Save a demo role",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('internshipId')) pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('smokeApplicationId', String(pm.response.json().id));",
              "  pm.test('Default status is SAVED', () => pm.expect(pm.response.json().status).to.equal('SAVED'));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/applications",
        "body": {
          "mode": "raw",
          "raw": "{\"internshipId\": {{internshipId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "6. Reject duplicate save",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('smokeApplicationId')) pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/applications",
        "body": {
          "mode": "raw",
          "raw": "{\"internshipId\": {{internshipId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "7. Update status",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('smokeApplicationId')) pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Status is INTERVIEW', () => pm.expect(pm.response.json().status).to.equal('INTERVIEW'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/applications/{{smokeApplicationId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"INTERVIEW\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "8. Read saved details",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('smokeApplicationId')) pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Status persisted', () => pm.expect(pm.response.json().status).to.equal('INTERVIEW'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/applications/{{smokeApplicationId}}"
      }
    },
    {
      "name": "9. Filter tracker",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('smokeApplicationId')) pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Only interview entries', () => pm.expect(pm.response.json().every(x => x.status === 'INTERVIEW')).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/applications?status=INTERVIEW"
      }
    },
    {
      "name": "10. Invalid status is rejected",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('smokeApplicationId')) pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/applications/{{smokeApplicationId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"INVALID\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "11. Remove only the test entry",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('smokeApplicationId')) pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/applications/{{smokeApplicationId}}"
      }
    },
    {
      "name": "12. Removed entry is unknown",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('smokeApplicationId')) pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/applications/{{smokeApplicationId}}"
      }
    }
  ]
}
